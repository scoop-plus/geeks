{
    "version": "6.7.1",
    "description": "Copy files between a local computer and remote servers using FTP, FTPS, SCP, SFTP, WebDAV or S3 file transfer protocols.",
    "homepage": "https://winscp.net",
    "license": "GPL-3.0-or-later",
    "url": "https://downloads.sourceforge.net/project/winscp/WinSCP/6.7.1/WinSCP-6.7.1-Portable.zip",
    "hash": "e6d2f8e1249e41f3bf8638319bb9bd15a541a64720df0805cb0bebdedb5eda83",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\winscp.ini\")) {",
        "    @(",
        "        '[Configuration\\Interface]'",
        "        \"RandomSeedFile=$persist_dir\\winscp.rnd\"",
        "    ) | Add-Content -Path \"$dir\\winscp.ini\" -Encoding ASCII -Force",
        "}"
    ],
    "bin": [
        "WinSCP.exe",
        [
            "WinSCP.com",
            "WinSCP-cli"
        ]
    ],
    "shortcuts": [
        [
            "WinSCP.exe",
            "WinSCP"
        ]
    ],
    "persist": [
        "winscp.ini",
        "Translations"
    ],
    "post_install": [
        "New-Item -ItemType Directory -Force -Path \"$dir\\Translations\" | Out-Null",
        "$WinSCP_chs = \"$dir\\Translations\\WinSCP.chs\"",
        "if (-not (Test-Path $WinSCP_chs)) {",
        "  $trans_url = \"https://winscp.net/translations/dll/$version/chs.zip\"",
        "  $trans_zip = \"$dir\\translations.zip\"",
        "  Write-Host",
        "  Write-Host 'Downloading WinSCP Translations pack...' -ForegroundColor Cyan",
        "  try {",
        "    Invoke-WebRequest -Uri $trans_url -OutFile $trans_zip -UseBasicParsing -ErrorAction Stop",
        "    if (Test-Path $trans_zip) {",
        "        Expand-Archive -Path $trans_zip -DestinationPath \"$dir\\Translations\" -Force",
        "        Remove-Item $trans_zip -Force",
        "        Write-Host 'Translations package integrated successfully.' -ForegroundColor Green",
        "    }",
        "  } catch {",
        "    Write-Host 'Failed to download the language pack. The file may not exist for this specific version.' -ForegroundColor Yellow",
        "  }",
        "}"
    ],
    "checkver": {
        "url": "https://winscp.net/eng/downloads.php",
        "regex": "WinSCP-([\\d.]+)-Portable\\.zip"
    },
    "autoupdate": {
        "url": "https://downloads.sourceforge.net/project/winscp/WinSCP/$version/WinSCP-$version-Portable.zip",
        "hash": {
            "url": "https://winscp.net/download/WinSCP-$version-ReadMe.txt",
            "regex": "(?sm)$basename.*?SHA-256: $sha256"
        }
    }
}
